{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "checkJs": true,
    "allowJs": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "..",
    "types": [],
    "paths": {
      "@minecraft/server": ["node_modules/@minecraft/server"]
    }
  },
  "include": ["../lib/**/*.js", "../lib/**/*.d.ts"],
  "exclude": ["../node_modules"]
}
